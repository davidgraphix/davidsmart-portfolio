# Contact form (api/contact.js) — SMTP settings for Nodemailer.
# Copy to .env.local for local development (`npm start`), and add the same
# variables in Vercel → Project → Settings → Environment Variables.
# Never prefix these with REACT_APP_ — that would bundle them into the browser.

# Gmail: use an App Password (Google Account → Security → 2-Step Verification → App passwords),
# not your normal Gmail password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your-sending-address@gmail.com
EMAIL_PASSWORD=your-16-character-app-password

# Where enquiries are delivered (defaults to bamideledavidsmart40@gmail.com if unset)
CONTACT_TO=bamideledavidsmart40@gmail.com
